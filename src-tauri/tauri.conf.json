{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droid Setup",
  "version": "0.2.0",
  "identifier": "com.fcode09.droidsetup",
  "build": {
    "beforeDevCommand": "npm run tools:prepare && npm start",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run tools:prepare && npm run build",
    "frontendDist": "../dist/droid-setup/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Droid Setup",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "resources": {
      "resources/adb/": "adb/",
      "resources/helper/": "helper/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Guided Android USB connection",
    "category": "Utility"
  }
}
