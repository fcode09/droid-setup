{
  "name": "droid-setup",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 1420",
    "build": "ng build && node scripts/check-web-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tools:prepare": "node scripts/prepare-adb.mjs && node scripts/verify-ui-helper.mjs",
    "check": "npm test && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@tauri-apps/cli": "2.12.4",
    "fflate": "0.8.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
